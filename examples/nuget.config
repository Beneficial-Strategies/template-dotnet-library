<?xml version="1.0" encoding="utf-8"?>
<!-- The examples use the package as a consumer does: the one built by `dotnet pack` into artifacts/packages (see tools/run-examples.sh);
     what it depends on, and any other package an example adds, comes from nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="BeneficialStrategies.Iso20022.Example" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
